# Copy to .env and set a local connection string.
# Option 1: PostgreSQL (Production / Integration testing)
DATABASE_URL=postgresql+psycopg2://cold_chain_app:REPLACE_PASSWORD@localhost:5432/cold_chain_dev

# Option 2: SQLite (Local development / Demonstration with verified dataset)
# DATABASE_URL=sqlite:///verification/final_stage_b_20261027_retry.sqlite

YOTTAFLEX_APP_ENV=development
YOTTAFLEX_LOG_LEVEL=INFO
# Comma-separated browser origins; do not use "*" with credentials.
YOTTAFLEX_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

